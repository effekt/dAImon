# Machine-specific overrides for slack-channel-watch. Copy to daemon.local.toml.
[daemon]
danger = true
# Poll cadence (seconds) — command latency is at most this.
schedule = { interval = 180 }

[inputs]
# Watch as many channels as you like; only ?-prefixed messages are commands.
watch_channels = ["C0123456789", "C0987654321"]
trigger_prefix = "?"
